// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  leagues  League[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Reference data: a real-world NBA snapshot, seeded once and shared by every
// league. Leagues never mutate these rows directly - a new League clones the
// snapshot into its own LeagueTeam / LeaguePlayer / Contract rows so each save
// can diverge independently (trades, extensions, retirements, etc.) without
// touching any other save or the canonical reference data.
// ---------------------------------------------------------------------------

enum Conference {
  EAST
  WEST
}

model Team {
  id             String     @id @default(cuid())
  externalId     String?    @unique
  abbreviation   String     @unique
  name           String
  city           String
  conference     Conference
  division       String
  primaryColor   String
  secondaryColor String
  logoUrl        String?

  players     Player[]
  leagueTeams LeagueTeam[]

  @@map("teams")
}

enum Position {
  PG
  SG
  SF
  PF
  C
}

model Player {
  id            String    @id @default(cuid())
  externalId    String?   @unique
  fullName      String
  position      Position
  birthDate     DateTime?
  heightInches  Int?
  weightLbs     Int?
  draftYear     Int?
  draftRound    Int?
  draftPick     Int?
  photoUrl      String?
  currentTeamId String?

  currentTeam   Team?              @relation(fields: [currentTeamId], references: [id])
  seasonStats   PlayerSeasonStat[]
  leaguePlayers LeaguePlayer[]

  @@index([currentTeamId])
  @@map("players")
}

// Real historical per-season stat lines, imported once. Used both to display
// scouting/comparison data and as feature input to the player valuation model.
model PlayerSeasonStat {
  id       String @id @default(cuid())
  playerId String
  season   Int // e.g. 2025 for the 2025-26 season
  team     String // abbreviation at time of season (a player can be traded mid-season)

  gamesPlayed          Int
  minutesPerGame       Float
  pointsPerGame        Float
  reboundsPerGame      Float
  assistsPerGame       Float
  stealsPerGame        Float
  blocksPerGame        Float
  turnoversPerGame     Float
  fgPct                Float?
  fg3Pct               Float?
  ftPct                Float?
  trueShootingPct      Float?
  usagePct             Float?
  winSharesPer48       Float?
  boxPlusMinus         Float?
  valueOverReplacement Float?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, team])
  @@index([playerId])
  @@map("player_season_stats")
}

// ---------------------------------------------------------------------------
// Per-save simulation state
// ---------------------------------------------------------------------------

model League {
  id                   String    @id @default(cuid())
  name                 String
  ownerId              String
  userControlledTeamId String? // set once the user picks which franchise to run
  currentSeason        Int // e.g. 2025 for 2025-26
  seasonStartedAt      DateTime  @default(now())
  salaryCapOverrideCents BigInt? // null = use the league-wide default for currentSeason
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // GM accountability (Phase 10d) - 0-100, see src/lib/gm/jobSecurity.ts.
  // Starts at a neutral "Stable" footing rather than 50/50, since a brand
  // new GM hasn't done anything to lose ownership's trust yet.
  ownerConfidence      Int       @default(65)
  // An active "reduce payroll below $X by season Y" directive, if
  // ownership has issued one - null when there's no outstanding
  // directive. Checked once, at the start of the season it targets.
  payrollReductionTargetCents BigInt?
  payrollDirectiveSeason      Int?

  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teams              LeagueTeam[]
  players            LeaguePlayer[]
  draftPicks         DraftPick[]
  draftProspects     DraftProspect[]
  trades             Trade[]
  tradeExceptions    TradeException[]
  assistantThreads   AssistantThread[]
  games              Game[]
  playoffSeries      PlayoffSeries[]
  seasonAwards       SeasonAward[]
  transactions       LeagueTransaction[]
  seasonExpectations SeasonExpectation[]

  @@index([ownerId])
  @@map("leagues")
}

enum TransactionType {
  TRADE
  SIGNING
  RETIREMENT
  INJURY
  OWNERSHIP_MESSAGE
}

enum ExpectationLevel {
  DEVELOP_YOUNG_PLAYERS
  COMPETE_FOR_PLAY_IN
  MAKE_PLAYOFFS
  WIN_PLAYOFF_SERIES
  DEEP_PLAYOFF_RUN
  CHAMPIONSHIP_CONTENTION
}

enum EvaluationVerdict {
  EXCEEDED
  MET
  FELL_SHORT
  DRASTICALLY_FELL_SHORT
}

// One row per league+season, capturing the preseason expectation set for
// the user's team from that season's payroll tier + roster quality at the
// moment the season begins - then updated with what actually happened, so
// the eventual evaluation always compares against what was expected at
// the time, not a standard re-computed from a roster that's since changed
// via trades/signings. See src/lib/gm/expectationLevel.ts.
model SeasonExpectation {
  id                   String             @id @default(cuid())
  leagueId             String
  season               Int
  expectationLevel     ExpectationLevel
  // Both null until the season concludes and advanceSeasonAction evaluates it.
  actualResultLabel    String?
  verdict              EvaluationVerdict?
  ownerConfidenceDelta Int?
  createdAt            DateTime           @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season])
  @@map("season_expectations")
}

// A denormalized, human-readable log entry for the transaction wire / news
// feed. `description` is pre-rendered at write time (see
// src/lib/transactions/describeTransaction.ts) rather than reconstructed
// from Trade/Contract rows at read time, since a trade or signing's
// human-readable form (team names, player names, deal terms) is fixed at
// the moment it happens and shouldn't change if e.g. a player is later
// traded again.
model LeagueTransaction {
  id          String          @id @default(cuid())
  leagueId    String
  season      Int
  type        TransactionType
  description String
  createdAt   DateTime        @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
  @@map("league_transactions")
}

// GM personality traits (Phase 11c) - a persistent front-office philosophy
// that reweights how much a team leans toward certain trade factors
// (youth vs. production, picks vs. players, salary flexibility). Assigned
// once per team at league bootstrap and stable for the life of the save,
// same as a real front office's standing tendencies.
enum GmPersonality {
  AGGRESSIVE
  CONSERVATIVE
  WIN_NOW
  PROSPECT_LOVER
  PICK_HOARDER
  SALARY_CONSCIOUS
  BALANCED
}

model LeagueTeam {
  id       String @id @default(cuid())
  leagueId String
  teamId   String

  wins   Int @default(0)
  losses Int @default(0)
  gmPersonality GmPersonality @default(BALANCED)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])

  players               LeaguePlayer[]
  reSigningRightsHolders LeaguePlayer[] @relation("ReSigningRights")
  contracts       Contract[]
  ownedPicks      DraftPick[]      @relation("CurrentOwner")
  originalPicks   DraftPick[]      @relation("OriginalTeam")
  tradeExceptions TradeException[]
  tradeAssetsFrom TradeAsset[]     @relation("AssetFromTeam")
  tradeAssetsTo   TradeAsset[]     @relation("AssetToTeam")
  homeGames       Game[]           @relation("HomeGames")
  awayGames       Game[]           @relation("AwayGames")
  higherSeedIn    PlayoffSeries[]  @relation("HigherSeedSeries")
  lowerSeedIn     PlayoffSeries[]  @relation("LowerSeedSeries")
  wonSeries       PlayoffSeries[]  @relation("WonSeries")

  @@unique([leagueId, teamId])
  @@index([leagueId])
  @@map("league_teams")
}

enum GameType {
  REGULAR_SEASON
  PLAY_IN
  PLAYOFF
}

// A simplified, strength-based schedule entry covering the regular season,
// play-in, and playoffs alike (see docs/ARCHITECTURE.md for how this
// differs from the real NBA). `homeScore`/`awayScore` are null until
// simulated. `seriesId` is set only for PLAYOFF games.
model Game {
  id               String    @id @default(cuid())
  leagueId         String
  season           Int
  gameNumber       Int // this team's/league's sequence position, not a calendar date
  type             GameType  @default(REGULAR_SEASON)
  seriesId         String?
  homeLeagueTeamId String
  awayLeagueTeamId String
  homeScore        Int?
  awayScore        Int?
  playedAt         DateTime?

  league   League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam LeagueTeam     @relation("HomeGames", fields: [homeLeagueTeamId], references: [id])
  awayTeam LeagueTeam     @relation("AwayGames", fields: [awayLeagueTeamId], references: [id])
  series   PlayoffSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([leagueId, season])
  @@index([leagueId, playedAt])
  @@map("games")
}

// Round 0 = play-in (single elimination, winsNeeded 1); round 1 = first
// round, 2 = conference semis, 3 = conference finals, 4 = NBA Finals
// (conference null for round 4). Best-of-7 rounds need 4 wins.
model PlayoffSeries {
  id               String      @id @default(cuid())
  leagueId         String
  season           Int
  round            Int
  // Position within this round+conference group (0-based). The next round's
  // slot N is always the winner of this round's slot 2N vs. slot 2N+1 - a
  // fixed single-elimination bracket, not a reseeded one, matching the real
  // NBA playoff format.
  bracketSlot      Int         @default(0)
  conference       Conference?
  higherSeedTeamId String
  lowerSeedTeamId  String
  winsNeeded       Int         @default(4)
  higherSeedWins   Int         @default(0)
  lowerSeedWins    Int         @default(0)
  winnerTeamId     String?

  league         League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  higherSeedTeam LeagueTeam @relation("HigherSeedSeries", fields: [higherSeedTeamId], references: [id])
  lowerSeedTeam  LeagueTeam @relation("LowerSeedSeries", fields: [lowerSeedTeamId], references: [id])
  winnerTeam     LeagueTeam? @relation("WonSeries", fields: [winnerTeamId], references: [id])
  games          Game[]

  @@index([leagueId, season, round])
  @@map("playoff_series")
}

enum InjuryStatus {
  HEALTHY
  DAY_TO_DAY
  OUT
  SEASON_ENDING
}

// The mutable, per-save copy of a player: this is what trades, aging, and
// development actually operate on. `overallRating` drifts over time (an age
// curve applied per season) independently in every league.
model LeaguePlayer {
  id              String       @id @default(cuid())
  leagueId        String
  playerId        String
  leagueTeamId    String? // null = unsigned free agent within this league
  overallRating   Int // 0-100 composite used by the valuation model & AI GMs
  potentialRating Int
  injuryStatus    InjuryStatus @default(HEALTHY)
  // Set only while injuryStatus != HEALTHY: the injured team's own
  // (wins+losses) count at which this player is cleared to return. Compared
  // against the team's regular-season game count, not a calendar date -
  // see src/lib/actions/leagueEvents.ts.
  injuryReturnsAtGamesPlayed Int?
  // Total games missed to injury across this player's whole league career
  // (incremented alongside the INJURY transaction log in
  // src/lib/actions/leagueEvents.ts) - real injury-history signal for the
  // trade-value model (Phase 11c), not just current health.
  careerGamesMissedToInjury Int @default(0)
  isActive        Boolean      @default(true) // false once retired within this league
  retiredSeason   Int? // the season this player retired after, if any
  // The team currently holding this player's simplified "Re-Signing
  // Rights" (a casual stand-in for real Bird/Early-Bird/Non-Bird rights -
  // see src/lib/freeagency/reSigningRights.ts). Kept in sync with
  // leagueTeamId on every signing/trade, but deliberately NOT cleared
  // when a contract expires, so it still points at the player's most
  // recent team while they're a free agent.
  reSigningTeamId String?

  league        League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player        Player        @relation(fields: [playerId], references: [id])
  leagueTeam    LeagueTeam?   @relation(fields: [leagueTeamId], references: [id])
  reSigningTeam LeagueTeam?   @relation("ReSigningRights", fields: [reSigningTeamId], references: [id])
  contract      Contract?
  tradeAssets   TradeAsset[]
  seasonAwards  SeasonAward[]

  @@unique([leagueId, playerId])
  @@index([leagueId, leagueTeamId])
  @@map("league_players")
}

enum AwardCategory {
  MVP
  ROOKIE_OF_THE_YEAR
  MOST_IMPROVED_PLAYER
}

// One row per league+season+category. Computed once when the season is
// advanced (from that season's final ratings/standings), then persisted
// rather than recomputed on every page view.
model SeasonAward {
  id             String        @id @default(cuid())
  leagueId       String
  season         Int
  category       AwardCategory
  leaguePlayerId String
  // The stat the award was decided on - rating for MVP/ROY, rating delta
  // for MIP - kept so the UI can show "why" without recomputing.
  value          Float

  league       League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season, category])
  @@index([leagueId, season])
  @@map("season_awards")
}

enum ContractOptionType {
  NONE
  PLAYER_OPTION
  TEAM_OPTION
}

enum ExceptionUsed {
  NONE
  MAX
  MID_LEVEL_TAXPAYER
  MID_LEVEL_ROOM
  MID_LEVEL_NON_TAXPAYER
  BI_ANNUAL
  ROOKIE_SCALE
  VETERAN_MINIMUM
  BIRD_RIGHTS
  EARLY_BIRD_RIGHTS
  NON_BIRD_RIGHTS
}

model Contract {
  id             String        @id @default(cuid())
  leaguePlayerId String        @unique
  leagueTeamId   String
  signedSeason   Int
  startSeason    Int
  endSeason      Int
  noTradeClause  Boolean       @default(false)
  signedUsing    ExceptionUsed @default(NONE)

  leaguePlayer LeaguePlayer   @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)
  leagueTeam   LeagueTeam     @relation(fields: [leagueTeamId], references: [id])
  years        ContractYear[]

  @@index([leagueTeamId])
  @@map("contracts")
}

// One row per season of a contract, so cap hits (which can balloon/decline,
// include partial guarantees, and carry options) are modeled precisely
// instead of assuming flat annual salaries.
model ContractYear {
  id              String             @id @default(cuid())
  contractId      String
  season          Int
  salaryCents     BigInt
  guaranteedCents BigInt
  optionType      ContractOptionType @default(NONE)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, season])
  @@map("contract_years")
}

model DraftPick {
  id                String  @id @default(cuid())
  leagueId          String
  season            Int
  round             Int // 1 or 2
  originalTeamId    String
  currentOwnerId    String
  protectionNote    String? // free text, e.g. "Top-4 protected, converts to 2027 2nd if not conveyed"
  // Set once the lottery/pick order is determined for this season (1-30 for
  // round 1, 31-60 for round 2) - null until `startDraftAction` runs.
  overallPickNumber Int?
  selectedProspectId String? @unique

  league           League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  originalTeam     LeagueTeam     @relation("OriginalTeam", fields: [originalTeamId], references: [id])
  currentOwner     LeagueTeam     @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  selectedProspect DraftProspect? @relation(fields: [selectedProspectId], references: [id])
  tradeAssets      TradeAsset[]

  @@index([leagueId])
  @@index([leagueId, season, overallPickNumber])
  @@map("draft_picks")
}

// A fictional prospect generated for one league's draft class - not a real
// person, since no real future draft class data exists (see
// docs/ARCHITECTURE.md). Ratings are generated once at `startDraftAction`
// time and are visible to the user immediately (no scouting uncertainty
// modeled yet).
model DraftProspect {
  id              String   @id @default(cuid())
  leagueId        String
  season           Int
  fullName        String
  position        Position
  age             Int
  overallRating   Int
  potentialRating Int

  league    League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  draftPick DraftPick?

  @@index([leagueId, season])
  @@map("draft_prospects")
}

enum TradeStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXECUTED
  CANCELLED
}

model Trade {
  id               String      @id @default(cuid())
  leagueId         String
  proposedById     String // LeagueTeam id
  status           TradeStatus @default(PROPOSED)
  validationResult Json? // snapshot of the validator's rule-by-rule pass/fail output
  createdAt        DateTime    @default(now())
  resolvedAt       DateTime?

  league League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  assets TradeAsset[]

  @@index([leagueId])
  @@map("trades")
}

enum TradeAssetType {
  PLAYER
  DRAFT_PICK
  CASH
  TRADE_EXCEPTION
}

model TradeAsset {
  id               String         @id @default(cuid())
  tradeId          String
  type             TradeAssetType
  fromLeagueTeamId String
  toLeagueTeamId   String
  leaguePlayerId   String?
  draftPickId      String?
  cashCents        BigInt?

  trade        Trade        @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fromTeam     LeagueTeam   @relation("AssetFromTeam", fields: [fromLeagueTeamId], references: [id])
  toTeam       LeagueTeam   @relation("AssetToTeam", fields: [toLeagueTeamId], references: [id])
  leaguePlayer LeaguePlayer? @relation(fields: [leaguePlayerId], references: [id])
  draftPick    DraftPick?    @relation(fields: [draftPickId], references: [id])

  @@index([tradeId])
  @@map("trade_assets")
}

// Created when a team trades away a player for less than they take back
// (or via a sign-and-trade); bankable for one year to absorb salary later.
model TradeException {
  id           String    @id @default(cuid())
  leagueId     String
  leagueTeamId String
  amountCents  BigInt
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?

  league     League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueTeam LeagueTeam @relation(fields: [leagueTeamId], references: [id])

  @@index([leagueId, leagueTeamId])
  @@map("trade_exceptions")
}

// ---------------------------------------------------------------------------
// AI GM Assistant
// ---------------------------------------------------------------------------

enum AssistantRole {
  USER
  ASSISTANT
  TOOL
}

model AssistantThread {
  id        String   @id @default(cuid())
  leagueId  String
  title     String
  createdAt DateTime @default(now())

  league   League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([leagueId])
  @@map("assistant_threads")
}

model AssistantMessage {
  id             String        @id @default(cuid())
  threadId       String
  role           AssistantRole
  content        String        @db.Text
  toolName       String? // set when role = TOOL: which grounding tool produced this content
  toolResultJson Json?
  createdAt      DateTime      @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("assistant_messages")
}
