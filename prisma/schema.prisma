// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  leagues  League[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Reference data: a real-world NBA snapshot, seeded once and shared by every
// league. Leagues never mutate these rows directly - a new League clones the
// snapshot into its own LeagueTeam / LeaguePlayer / Contract rows so each save
// can diverge independently (trades, extensions, retirements, etc.) without
// touching any other save or the canonical reference data.
// ---------------------------------------------------------------------------

enum Conference {
  EAST
  WEST
}

// Real, sourced classification (metro-area size) - same category of
// fixture data as city/conference/colors, not fabricated. Drives fan
// engagement's attendance/franchise-popularity baselines.
enum MarketSize {
  LARGE
  MID
  SMALL
}

model Team {
  id             String     @id @default(cuid())
  externalId     String?    @unique
  abbreviation   String     @unique
  name           String
  city           String
  conference     Conference
  division       String
  primaryColor   String
  secondaryColor String
  logoUrl        String?
  // Defaulted (not left nullable) so the migration doesn't fail against
  // the 30 real Team rows that already exist - seedTeams() immediately
  // overwrites every row with its real per-team value right after.
  marketSize     MarketSize @default(MID)

  players     Player[]
  leagueTeams LeagueTeam[]

  @@map("teams")
}

enum Position {
  PG
  SG
  SF
  PF
  C
}

model Player {
  id            String    @id @default(cuid())
  externalId    String?   @unique
  fullName      String
  position      Position
  birthDate     DateTime?
  heightInches  Int?
  weightLbs     Int?
  draftYear     Int?
  draftRound    Int?
  draftPick     Int?
  photoUrl      String?
  currentTeamId String?

  currentTeam   Team?              @relation(fields: [currentTeamId], references: [id])
  seasonStats   PlayerSeasonStat[]
  leaguePlayers LeaguePlayer[]

  @@index([currentTeamId])
  @@map("players")
}

// Real historical per-season stat lines, imported once. Used both to display
// scouting/comparison data and as feature input to the player valuation model.
model PlayerSeasonStat {
  id       String @id @default(cuid())
  playerId String
  season   Int // e.g. 2025 for the 2025-26 season
  team     String // abbreviation at time of season (a player can be traded mid-season)

  gamesPlayed          Int
  minutesPerGame       Float
  pointsPerGame        Float
  reboundsPerGame      Float
  assistsPerGame       Float
  stealsPerGame        Float
  blocksPerGame        Float
  turnoversPerGame     Float
  fgPct                Float?
  fg3Pct               Float?
  ftPct                Float?
  trueShootingPct      Float?
  usagePct             Float?
  winSharesPer48       Float?
  boxPlusMinus         Float?
  valueOverReplacement Float?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, team])
  @@index([playerId])
  @@map("player_season_stats")
}

// ---------------------------------------------------------------------------
// Per-save simulation state
// ---------------------------------------------------------------------------

model League {
  id                          String   @id @default(cuid())
  name                        String
  ownerId                     String
  userControlledTeamId        String? // set once the user picks which franchise to run
  currentSeason               Int // e.g. 2025 for 2025-26
  seasonStartedAt             DateTime @default(now())
  salaryCapOverrideCents      BigInt? // null = use the league-wide default for currentSeason
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  // GM accountability (Phase 10d) - 0-100, see src/lib/gm/jobSecurity.ts.
  // Starts at a neutral "Stable" footing rather than 50/50, since a brand
  // new GM hasn't done anything to lose ownership's trust yet.
  ownerConfidence             Int      @default(65)
  // An active "reduce payroll below $X by season Y" directive, if
  // ownership has issued one - null when there's no outstanding
  // directive. Checked once, at the start of the season it targets.
  payrollReductionTargetCents BigInt?
  payrollDirectiveSeason      Int?

  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teams              LeagueTeam[]
  players            LeaguePlayer[]
  draftPicks         DraftPick[]
  draftProspects     DraftProspect[]
  trades             Trade[]
  tradeExceptions    TradeException[]
  assistantThreads   AssistantThread[]
  games              Game[]
  playoffSeries      PlayoffSeries[]
  seasonAwards       SeasonAward[]
  transactions       LeagueTransaction[]
  seasonExpectations SeasonExpectation[]
  playerGameStats    PlayerGameStat[]
  staff              Staff[]
  staffAwards        StaffAward[]
  fanHappinessSnapshots FanHappinessSnapshot[]
  allStarWeekends    AllStarWeekend[]

  @@index([ownerId])
  @@map("leagues")
}

enum TransactionType {
  TRADE
  SIGNING
  RETIREMENT
  INJURY
  OWNERSHIP_MESSAGE
  // Real, box-score-driven categories (Phase 14d) - generated only from
  // actual simulated events (see src/lib/transactions/describeGameEvents.ts),
  // never invented.
  GAME_MILESTONE
  WIN_STREAK
  GAME_RESULT
  // Real season-end awards (Phase 14e) - announced once computed in
  // advanceSeasonAction, using the same SeasonAward rows already shown
  // elsewhere, not a new source of truth.
  AWARD
  // Real staff hiring/firing (Phase 15a) - see the Staff model below.
  STAFF_HIRE
  STAFF_FIRE
  // Real All-Star Weekend coverage, generated once per season from the
  // actual AllStarWeekend row - see the models below.
  ALL_STAR_SELECTION
  ALL_STAR_SNUB
  ALL_STAR_RESULT
}

// Lets the UI prioritize significant events over routine ones. Existing
// transaction types are backfilled to STANDARD (no reliable way to
// reconstruct a truer value for already-written rows); every category
// assigns this deliberately going forward - see
// src/lib/transactions/newsImportance.ts.
enum NewsImportance {
  MINOR
  STANDARD
  MAJOR
  BREAKING
}

enum ExpectationLevel {
  DEVELOP_YOUNG_PLAYERS
  COMPETE_FOR_PLAY_IN
  MAKE_PLAYOFFS
  WIN_PLAYOFF_SERIES
  DEEP_PLAYOFF_RUN
  CHAMPIONSHIP_CONTENTION
}

enum EvaluationVerdict {
  EXCEEDED
  MET
  FELL_SHORT
  DRASTICALLY_FELL_SHORT
}

// One row per league+season, capturing the preseason expectation set for
// the user's team from that season's payroll tier + roster quality at the
// moment the season begins - then updated with what actually happened, so
// the eventual evaluation always compares against what was expected at
// the time, not a standard re-computed from a roster that's since changed
// via trades/signings. See src/lib/gm/expectationLevel.ts.
model SeasonExpectation {
  id                   String             @id @default(cuid())
  leagueId             String
  season               Int
  expectationLevel     ExpectationLevel
  // Both null until the season concludes and advanceSeasonAction evaluates it.
  actualResultLabel    String?
  verdict              EvaluationVerdict?
  ownerConfidenceDelta Int?
  createdAt            DateTime           @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season])
  @@map("season_expectations")
}

// A denormalized, human-readable log entry for the transaction wire / news
// feed. `description` is pre-rendered at write time (see
// src/lib/transactions/describeTransaction.ts) rather than reconstructed
// from Trade/Contract rows at read time, since a trade or signing's
// human-readable form (team names, player names, deal terms) is fixed at
// the moment it happens and shouldn't change if e.g. a player is later
// traded again.
model LeagueTransaction {
  id          String          @id @default(cuid())
  leagueId    String
  season      Int
  type        TransactionType
  description String
  importance  NewsImportance  @default(STANDARD)
  // Every LeagueTeam id substantively involved (1 for a signing/injury/
  // award, 2 for a trade/game) - powers "My Team" filtering. Defaults to
  // empty for rows written before this field existed (Phase 14e) - there's
  // no reliable way to reconstruct team involvement from free-text
  // descriptions alone, so old rows just won't match a team filter,
  // consistent with this project's forward-only backfill precedent.
  teamIds     String[]        @default([])
  createdAt   DateTime        @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
  @@map("league_transactions")
}

// GM personality traits (Phase 11c) - a persistent front-office philosophy
// that reweights how much a team leans toward certain trade factors
// (youth vs. production, picks vs. players, salary flexibility). Assigned
// once per team at league bootstrap and stable for the life of the save,
// same as a real front office's standing tendencies.
enum GmPersonality {
  AGGRESSIVE
  CONSERVATIVE
  WIN_NOW
  PROSPECT_LOVER
  PICK_HOARDER
  SALARY_CONSCIOUS
  BALANCED
}

model LeagueTeam {
  id       String @id @default(cuid())
  leagueId String
  teamId   String

  wins          Int           @default(0)
  losses        Int           @default(0)
  gmPersonality GmPersonality @default(BALANCED)
  // Positive = current win streak, negative = current loss streak, reset
  // to 0 each new season alongside wins/losses. Powers real WIN_STREAK
  // news (src/lib/transactions/describeGameEvents.ts) - not derived by
  // scanning Game history on read.
  currentStreak Int           @default(0)
  // Fan engagement - 0-100, same neutral-start convention as
  // League.ownerConfidence. Recomputed every season for all 30 teams
  // (src/lib/fans/), not just the user's - franchisePopularity needs a
  // full-league comparison to mean anything.
  fanHappiness  Int           @default(65)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])

  players                LeaguePlayer[]
  reSigningRightsHolders LeaguePlayer[]   @relation("ReSigningRights")
  contracts              Contract[]
  ownedPicks             DraftPick[]      @relation("CurrentOwner")
  originalPicks          DraftPick[]      @relation("OriginalTeam")
  tradeExceptions        TradeException[]
  tradeAssetsFrom        TradeAsset[]     @relation("AssetFromTeam")
  tradeAssetsTo          TradeAsset[]     @relation("AssetToTeam")
  homeGames              Game[]           @relation("HomeGames")
  awayGames              Game[]           @relation("AwayGames")
  higherSeedIn           PlayoffSeries[]  @relation("HigherSeedSeries")
  lowerSeedIn            PlayoffSeries[]  @relation("LowerSeedSeries")
  wonSeries              PlayoffSeries[]  @relation("WonSeries")
  playerGameStats        PlayerGameStat[]
  staff                  Staff[]
  staffContracts         StaffContract[]
  fanHappinessSnapshots  FanHappinessSnapshot[]

  @@unique([leagueId, teamId])
  @@index([leagueId])
  @@map("league_teams")
}

// One row per league+team+season - powers a multi-season trend graph the
// same way SeasonAward/SeasonExpectation persist once rather than
// recompute on every read. attendancePct/franchisePopularity are derived,
// presentational numbers (see src/lib/fans/fanHappiness.ts) - deliberately
// no separate merchandise/ticket-demand/buzz columns, since those are
// UI-side tier labels read off these two numbers + marketSize, not
// independently tracked state.
model FanHappinessSnapshot {
  id                  String @id @default(cuid())
  leagueId            String
  leagueTeamId        String
  season              Int
  fanHappiness        Int
  attendancePct       Float
  franchisePopularity Int

  league     League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueTeam LeagueTeam @relation(fields: [leagueTeamId], references: [id], onDelete: Cascade)

  @@unique([leagueId, leagueTeamId, season])
  @@index([leagueId, leagueTeamId])
  @@map("fan_happiness_snapshots")
}

enum GameType {
  REGULAR_SEASON
  PLAY_IN
  PLAYOFF
}

// A simplified, strength-based schedule entry covering the regular season,
// play-in, and playoffs alike (see docs/ARCHITECTURE.md for how this
// differs from the real NBA). `homeScore`/`awayScore` are null until
// simulated. `seriesId` is set only for PLAYOFF games.
model Game {
  id               String    @id @default(cuid())
  leagueId         String
  season           Int
  gameNumber       Int // sequence position within the season, derived from dayIndex order
  // Sequential day-of-season index (1-based), assigned at schedule
  // generation - not a real DateTime (see generateSchedule.ts). Null for
  // games generated before this field shipped - existing mid-season
  // leagues keep their old schedule as-is rather than a destructive
  // regeneration.
  dayIndex         Int?
  type             GameType  @default(REGULAR_SEASON)
  seriesId         String?
  homeLeagueTeamId String
  awayLeagueTeamId String
  homeScore        Int?
  awayScore        Int?
  playedAt         DateTime?

  league          League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam        LeagueTeam       @relation("HomeGames", fields: [homeLeagueTeamId], references: [id])
  awayTeam        LeagueTeam       @relation("AwayGames", fields: [awayLeagueTeamId], references: [id])
  series          PlayoffSeries?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  playerGameStats PlayerGameStat[]

  @@index([leagueId, season])
  @@index([leagueId, playedAt])
  @@map("games")
}

// One row per player who actually played in a given simulated game -
// see src/lib/simulation/boxScore.ts for how these are generated.
// Deliberately no stored fgPct/plusMinus: percentages derive cheaply from
// made/attempted on read, and plusMinus would need possession-level on/off
// data this lightweight (not possession-by-possession) engine doesn't
// produce. A player who didn't play gets no row at all, not a
// minutesPlayed: 0 row, so "games played" denominators stay clean.
model PlayerGameStat {
  id             String   @id @default(cuid())
  gameId         String
  leagueId       String // denormalized from Game - every league-scoped query (leaders, records) needs this without a join
  leaguePlayerId String
  leagueTeamId   String // pinned to the team as of this game, survives a later trade
  season         Int // denormalized from Game, cheap season-aggregate queries
  gameType       GameType // denormalized from Game, cheap regular-season-vs-playoff filtering

  minutesPlayed Int
  points        Int
  rebounds      Int
  assists       Int
  steals        Int
  blocks        Int
  turnovers     Int
  fgMade        Int
  fgAttempted   Int
  fg3Made       Int
  fg3Attempted  Int
  ftMade        Int
  ftAttempted   Int

  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  league       League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)
  leagueTeam   LeagueTeam   @relation(fields: [leagueTeamId], references: [id])

  @@unique([gameId, leaguePlayerId])
  @@index([leaguePlayerId, season])
  @@index([leagueId, season])
  @@index([gameId])
  @@map("player_game_stats")
}

// Round 0 = play-in (single elimination, winsNeeded 1); round 1 = first
// round, 2 = conference semis, 3 = conference finals, 4 = NBA Finals
// (conference null for round 4). Best-of-7 rounds need 4 wins.
model PlayoffSeries {
  id               String      @id @default(cuid())
  leagueId         String
  season           Int
  round            Int
  // Position within this round+conference group (0-based). The next round's
  // slot N is always the winner of this round's slot 2N vs. slot 2N+1 - a
  // fixed single-elimination bracket, not a reseeded one, matching the real
  // NBA playoff format.
  bracketSlot      Int         @default(0)
  conference       Conference?
  higherSeedTeamId String
  lowerSeedTeamId  String
  winsNeeded       Int         @default(4)
  higherSeedWins   Int         @default(0)
  lowerSeedWins    Int         @default(0)
  winnerTeamId     String?

  league         League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  higherSeedTeam LeagueTeam  @relation("HigherSeedSeries", fields: [higherSeedTeamId], references: [id])
  lowerSeedTeam  LeagueTeam  @relation("LowerSeedSeries", fields: [lowerSeedTeamId], references: [id])
  winnerTeam     LeagueTeam? @relation("WonSeries", fields: [winnerTeamId], references: [id])
  games          Game[]

  @@index([leagueId, season, round])
  @@map("playoff_series")
}

enum InjuryStatus {
  HEALTHY
  DAY_TO_DAY
  OUT
  SEASON_ENDING
}

// The mutable, per-save copy of a player: this is what trades, aging, and
// development actually operate on. `overallRating` drifts over time (an age
// curve applied per season) independently in every league.
model LeaguePlayer {
  id                         String       @id @default(cuid())
  leagueId                   String
  playerId                   String
  leagueTeamId               String? // null = unsigned free agent within this league
  overallRating              Int // 0-100 composite used by the valuation model & AI GMs
  potentialRating            Int
  injuryStatus               InjuryStatus @default(HEALTHY)
  // Set only while injuryStatus != HEALTHY: the injured team's own
  // (wins+losses) count at which this player is cleared to return. Compared
  // against the team's regular-season game count, not a calendar date -
  // see src/lib/actions/leagueEvents.ts.
  injuryReturnsAtGamesPlayed Int?
  // Total games missed to injury across this player's whole league career
  // (incremented alongside the INJURY transaction log in
  // src/lib/actions/leagueEvents.ts) - real injury-history signal for the
  // trade-value model (Phase 11c), not just current health.
  careerGamesMissedToInjury  Int          @default(0)
  isActive                   Boolean      @default(true) // false once retired within this league
  retiredSeason              Int? // the season this player retired after, if any
  // The team currently holding this player's simplified "Re-Signing
  // Rights" (a casual stand-in for real Bird/Early-Bird/Non-Bird rights -
  // see src/lib/freeagency/reSigningRights.ts). Kept in sync with
  // leagueTeamId on every signing/trade, but deliberately NOT cleared
  // when a contract expires, so it still points at the player's most
  // recent team while they're a free agent.
  reSigningTeamId            String?

  league          League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player          Player           @relation(fields: [playerId], references: [id])
  leagueTeam      LeagueTeam?      @relation(fields: [leagueTeamId], references: [id])
  reSigningTeam   LeagueTeam?      @relation("ReSigningRights", fields: [reSigningTeamId], references: [id])
  contract        Contract?
  tradeAssets     TradeAsset[]
  seasonAwards            SeasonAward[]
  playerGameStats         PlayerGameStat[]
  allStarSelections       AllStarSelection[]
  allStarEventParticipants AllStarEventParticipant[]
  allStarGameStats        AllStarGameStat[]

  @@unique([leagueId, playerId])
  @@index([leagueId, leagueTeamId])
  @@map("league_players")
}

enum AwardCategory {
  MVP
  ROOKIE_OF_THE_YEAR
  MOST_IMPROVED_PLAYER
  // Unblocked by Phase 14a/14b's real box-score data - previously excluded
  // for lacking individual defensive/bench-usage stats to back them
  // honestly. See src/lib/development/seasonAwards.ts.
  DEFENSIVE_PLAYER_OF_THE_YEAR
  SIXTH_MAN_OF_THE_YEAR
}

// One row per league+season+category. Computed once when the season is
// advanced (from that season's final ratings/standings), then persisted
// rather than recomputed on every page view.
model SeasonAward {
  id             String        @id @default(cuid())
  leagueId       String
  season         Int
  category       AwardCategory
  leaguePlayerId String
  // The stat the award was decided on - rating for MVP/ROY, rating delta
  // for MIP - kept so the UI can show "why" without recomputing.
  value          Float

  league       League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season, category])
  @@index([leagueId, season])
  @@map("season_awards")
}

enum ContractOptionType {
  NONE
  PLAYER_OPTION
  TEAM_OPTION
}

enum ExceptionUsed {
  NONE
  MAX
  MID_LEVEL_TAXPAYER
  MID_LEVEL_ROOM
  MID_LEVEL_NON_TAXPAYER
  BI_ANNUAL
  ROOKIE_SCALE
  VETERAN_MINIMUM
  BIRD_RIGHTS
  EARLY_BIRD_RIGHTS
  NON_BIRD_RIGHTS
}

model Contract {
  id             String        @id @default(cuid())
  leaguePlayerId String        @unique
  leagueTeamId   String
  signedSeason   Int
  startSeason    Int
  endSeason      Int
  noTradeClause  Boolean       @default(false)
  signedUsing    ExceptionUsed @default(NONE)

  leaguePlayer LeaguePlayer   @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)
  leagueTeam   LeagueTeam     @relation(fields: [leagueTeamId], references: [id])
  years        ContractYear[]

  @@index([leagueTeamId])
  @@map("contracts")
}

// One row per season of a contract, so cap hits (which can balloon/decline,
// include partial guarantees, and carry options) are modeled precisely
// instead of assuming flat annual salaries.
model ContractYear {
  id              String             @id @default(cuid())
  contractId      String
  season          Int
  salaryCents     BigInt
  guaranteedCents BigInt
  optionType      ContractOptionType @default(NONE)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, season])
  @@map("contract_years")
}

// Staff Management (Phase 15a) - Head Coach, Player Development Coach, and
// Medical Staff, the three roles with a real, identified mechanical effect
// on the simulation (see src/lib/simulation/boxScore.ts,
// src/lib/development/developPlayerRating.ts, and
// src/lib/actions/leagueEvents.ts respectively). Deliberately scoped down
// from the full staff roster a real front office has - Scouts, Analytics,
// and a Salary Cap Specialist are a later phase, and there is no hireable
// "GM" role at all: the user already is the GM (see League.ownerConfidence/
// src/lib/gm/jobSecurity.ts), this models the staff working for them.
enum StaffRole {
  HEAD_COACH
  PLAYER_DEVELOPMENT_COACH
  MEDICAL_STAFF
}

// Head Coach only - a flavor/style axis distinct from `quality` (skill).
// Drives shot-selection tendency in box-score generation, not a skill level.
enum CoachStyle {
  PACE_AND_SPACE
  BALANCED
  GRIND_IT_OUT
}

model Staff {
  id           String      @id @default(cuid())
  leagueId     String
  leagueTeamId String? // null = unemployed, available on the market
  role         StaffRole
  fullName     String
  age          Int
  // 60-99, same composite-rating convention as LeaguePlayer.overallRating -
  // "how good are they at this job."
  quality      Int
  // 0-100, distinct from quality (skill) - drifts with team performance
  // each season (src/lib/actions/offseason.ts). A young/unproven hire can
  // be high-quality/low-reputation.
  reputation   Int         @default(50)
  style        CoachStyle? // Head Coach only, null for the other two roles

  league      League          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueTeam  LeagueTeam?     @relation(fields: [leagueTeamId], references: [id])
  contract    StaffContract?
  staffAwards StaffAward[]

  @@index([leagueId, leagueTeamId])
  @@index([leagueId, role])
  @@map("staff")
}

// Deliberately a separate model from Contract, not a generalized/nullable
// version of it - Contract.leaguePlayerId is @unique with no discriminator
// column, and every existing call site assumes contract.leaguePlayer always
// exists. Also simpler on purpose: one flat annual salary, no
// ContractYear-equivalent year-by-year structure - coaching deals don't need
// cap-style guarantees here, and staff salaries never count against the
// player salary cap.
model StaffContract {
  id                String @id @default(cuid())
  staffId           String @unique
  leagueTeamId      String
  signedSeason      Int
  startSeason       Int
  endSeason         Int
  annualSalaryCents BigInt

  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leagueTeam LeagueTeam @relation(fields: [leagueTeamId], references: [id])

  @@map("staff_contracts")
}

enum StaffAwardCategory {
  COACH_OF_THE_YEAR
}

// Separate from SeasonAward (not a nullable/generalized version of it) for
// the same reason Staff/StaffContract are separate from LeaguePlayer/Contract
// - SeasonAward.leaguePlayerId is required with no discriminator column, and
// every existing call site assumes the winner is always a LeaguePlayer.
model StaffAward {
  id       String             @id @default(cuid())
  leagueId String
  season   Int
  category StaffAwardCategory
  staffId  String
  // The stat the award was decided on - that season's team win% - same
  // "keep the why" intent as SeasonAward.value.
  value    Float

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season, category])
  @@index([leagueId, season])
  @@map("staff_awards")
}

enum AllStarWeekendStatus {
  PENDING // generated, not yet resolved - blocks further regular-season sim
  RESOLVED // user has viewed/skipped it - regular season can resume
}

enum AllStarRole {
  STARTER
  RESERVE
  INJURY_REPLACEMENT
}

enum AllStarPositionGroup {
  GUARD
  FRONTCOURT
}

enum AllStarEventType {
  RISING_STARS
  THREE_POINT_CONTEST
  SLAM_DUNK_CONTEST
}

// One row per league+season - its existence/status is the mid-season
// checkpoint marker src/lib/actions/simulation.ts checks before allowing
// further regular-season simulation, not a separate League field.
model AllStarWeekend {
  id                  String               @id @default(cuid())
  leagueId            String
  season              Int
  status              AllStarWeekendStatus @default(PENDING)
  triggeredAtDayIndex Int?
  createdAt           DateTime             @default(now())

  league       League                    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  selections   AllStarSelection[]
  participants AllStarEventParticipant[]
  game         AllStarGame?

  @@unique([leagueId, season])
  @@map("all_star_weekends")
}

// Separate from SeasonAward/StaffAward - both assume exactly one winner
// per category per season; an All-Star roster is 24+ players.
model AllStarSelection {
  id               String               @id @default(cuid())
  allStarWeekendId String
  leaguePlayerId   String
  conference       Conference
  positionGroup    AllStarPositionGroup
  role             AllStarRole
  // Snapshot at selection time - "why", same intent as SeasonAward.value.
  performanceScore Float
  pointsPerGame    Float
  reboundsPerGame  Float
  assistsPerGame   Float
  teamWinPct       Float

  allStarWeekend AllStarWeekend @relation(fields: [allStarWeekendId], references: [id], onDelete: Cascade)
  leaguePlayer   LeaguePlayer   @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([allStarWeekendId, leaguePlayerId])
  @@map("all_star_selections")
}

// One shared model for the 3 contests (structurally identical: a
// participant, a result, a score) rather than 3 near-duplicate tables -
// round-by-round detail is a short result string ("CHAMPION"/
// "ELIMINATED_ROUND_1"), not a full play-by-play log.
model AllStarEventParticipant {
  id               String           @id @default(cuid())
  allStarWeekendId String
  eventType        AllStarEventType
  leaguePlayerId   String
  seed             Int
  result           String
  score            Float

  allStarWeekend AllStarWeekend @relation(fields: [allStarWeekendId], references: [id], onDelete: Cascade)
  leaguePlayer   LeaguePlayer   @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([allStarWeekendId, eventType, leaguePlayerId])
  @@map("all_star_event_participants")
}

// The exhibition game itself - deliberately not a row in the existing
// Game model, since Game.home/awayLeagueTeamId are required FKs to real
// franchise teams and All-Star "sides" are ad-hoc captain-drafted squads,
// not LeagueTeams. Reuses the simulation engine's pure functions, not its
// Game/LeagueTeam-shaped persistence.
model AllStarGame {
  id                String @id @default(cuid())
  allStarWeekendId  String @unique
  teamACaptainId    String
  teamBCaptainId    String
  teamAScore        Int
  teamBScore        Int
  mvpLeaguePlayerId String

  allStarWeekend AllStarWeekend    @relation(fields: [allStarWeekendId], references: [id], onDelete: Cascade)
  stats          AllStarGameStat[]

  @@map("all_star_games")
}

// Mirrors PlayerBoxScoreLine's fields, minus the real Game/LeagueTeam FKs
// PlayerGameStat requires - `side` replaces leagueTeamId.
model AllStarGameStat {
  id             String @id @default(cuid())
  allStarGameId  String
  leaguePlayerId String
  side           String // teamACaptainId or teamBCaptainId
  minutesPlayed  Int
  points         Int
  rebounds       Int
  assists        Int
  steals         Int
  blocks         Int
  turnovers      Int
  fgMade         Int
  fgAttempted    Int
  fg3Made        Int
  fg3Attempted   Int
  ftMade         Int
  ftAttempted    Int

  allStarGame  AllStarGame  @relation(fields: [allStarGameId], references: [id], onDelete: Cascade)
  leaguePlayer LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@map("all_star_game_stats")
}

model DraftPick {
  id                 String  @id @default(cuid())
  leagueId           String
  season             Int
  round              Int // 1 or 2
  originalTeamId     String
  currentOwnerId     String
  protectionNote     String? // free text, e.g. "Top-4 protected, converts to 2027 2nd if not conveyed"
  // Set once the lottery/pick order is determined for this season (1-30 for
  // round 1, 31-60 for round 2) - null until `startDraftAction` runs.
  overallPickNumber  Int?
  selectedProspectId String? @unique

  league           League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  originalTeam     LeagueTeam     @relation("OriginalTeam", fields: [originalTeamId], references: [id])
  currentOwner     LeagueTeam     @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  selectedProspect DraftProspect? @relation(fields: [selectedProspectId], references: [id])
  tradeAssets      TradeAsset[]

  @@index([leagueId])
  @@index([leagueId, season, overallPickNumber])
  @@map("draft_picks")
}

// A fictional prospect generated for one league's draft class - not a real
// person, since no real future draft class data exists (see
// docs/ARCHITECTURE.md). Ratings are generated once at `startDraftAction`
// time and are visible to the user immediately (no scouting uncertainty
// modeled yet).
model DraftProspect {
  id              String   @id @default(cuid())
  leagueId        String
  season          Int
  fullName        String
  position        Position
  age             Int
  overallRating   Int
  potentialRating Int

  league    League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  draftPick DraftPick?

  @@index([leagueId, season])
  @@map("draft_prospects")
}

enum TradeStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXECUTED
  CANCELLED
}

model Trade {
  id               String      @id @default(cuid())
  leagueId         String
  proposedById     String // LeagueTeam id
  status           TradeStatus @default(PROPOSED)
  validationResult Json? // snapshot of the validator's rule-by-rule pass/fail output
  createdAt        DateTime    @default(now())
  resolvedAt       DateTime?

  league League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  assets TradeAsset[]

  @@index([leagueId])
  @@map("trades")
}

enum TradeAssetType {
  PLAYER
  DRAFT_PICK
  CASH
  TRADE_EXCEPTION
}

model TradeAsset {
  id               String         @id @default(cuid())
  tradeId          String
  type             TradeAssetType
  fromLeagueTeamId String
  toLeagueTeamId   String
  leaguePlayerId   String?
  draftPickId      String?
  cashCents        BigInt?

  trade        Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fromTeam     LeagueTeam    @relation("AssetFromTeam", fields: [fromLeagueTeamId], references: [id])
  toTeam       LeagueTeam    @relation("AssetToTeam", fields: [toLeagueTeamId], references: [id])
  leaguePlayer LeaguePlayer? @relation(fields: [leaguePlayerId], references: [id])
  draftPick    DraftPick?    @relation(fields: [draftPickId], references: [id])

  @@index([tradeId])
  @@map("trade_assets")
}

// Created when a team trades away a player for less than they take back
// (or via a sign-and-trade); bankable for one year to absorb salary later.
model TradeException {
  id           String    @id @default(cuid())
  leagueId     String
  leagueTeamId String
  amountCents  BigInt
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?

  league     League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueTeam LeagueTeam @relation(fields: [leagueTeamId], references: [id])

  @@index([leagueId, leagueTeamId])
  @@map("trade_exceptions")
}

// ---------------------------------------------------------------------------
// AI GM Assistant
// ---------------------------------------------------------------------------

enum AssistantRole {
  USER
  ASSISTANT
  TOOL
}

model AssistantThread {
  id        String   @id @default(cuid())
  leagueId  String
  title     String
  createdAt DateTime @default(now())

  league   League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([leagueId])
  @@map("assistant_threads")
}

model AssistantMessage {
  id             String        @id @default(cuid())
  threadId       String
  role           AssistantRole
  content        String        @db.Text
  toolName       String? // set when role = TOOL: which grounding tool produced this content
  toolResultJson Json?
  createdAt      DateTime      @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("assistant_messages")
}
