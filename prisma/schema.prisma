model Trade {
  id               String              @id @default(cuid())
  leagueId         String
  proposedById     String
  status           TradeStatus         @default(PROPOSED)
  validationResult Json?
  /// Immutable cap evidence, frozen at execution. The outcome surface
  /// (/leagues/[id]/trades/[tradeId]) must stay truthful on a revisit years
  /// later, and cap sheets are otherwise always computed live from *current*
  /// league state - recomputing would silently report today's cap as though it
  /// were the cap at trade time. Shape: TradeCapSnapshot in
  /// src/lib/trade/capSnapshot.ts. Json (not scalar columns) follows the
  /// convention `validationResult` already sets on this model: frozen evidence
  /// read back whole by one surface, never filtered or aggregated. This is
  /// never a source of truth for live cap math - see computeCapSheet.
  capSnapshot      Json?
  createdAt        DateTime            @default(now())
  resolvedAt       DateTime?
  assets           TradeAsset[]
  league           League              @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  /// Narrative rows (fan sentiment, icon departures, the trade headline) this
  /// trade generated, so the outcome surface can reconstruct the story.
  transactions     LeagueTransaction[]

  @@index([leagueId])
  @@map("trades")
}

