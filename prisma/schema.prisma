generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String         @id @default(cuid())
  name                  String?
  email                 String?        @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  createdAt             DateTime       @default(now())
  gmReputation          Int            @default(50)
  onboardingCompletedAt DateTime?
  accounts              Account[]
  careerRecords         CareerRecord[]
  leagues               League[]
  sessions              Session[]

  @@map("users")
}

model CareerRecord {
  id                      String          @id @default(cuid())
  userId                  String
  leagueId                String?
  teamLabel               String
  seasons                 Int
  wins                    Int
  losses                  Int
  championships           Int
  playoffAppearances      Int
  bestPlayoffFinish       String
  careerEarningsCents     BigInt
  notableTradeDescription String?
  endReason               CareerEndReason
  finalOwnerConfidence    Int
  reputationDelta         Int
  createdAt               DateTime        @default(now())
  league                  League?         @relation(fields: [leagueId], references: [id])
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("career_records")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Team {
  id             String       @id @default(cuid())
  externalId     String?      @unique
  abbreviation   String       @unique
  name           String
  city           String
  conference     Conference
  division       String
  primaryColor   String
  secondaryColor String
  logoUrl        String?
  marketSize     MarketSize   @default(MID)
  leagueTeams    LeagueTeam[]
  players        Player[]

  @@map("teams")
}

model Player {
  id                  String                   @id @default(cuid())
  externalId          String?                  @unique
  fullName            String
  position            Position
  birthDate           DateTime?
  heightInches        Int?
  weightLbs           Int?
  draftYear           Int?
  draftRound          Int?
  draftPick           Int?
  photoUrl            String?
  currentTeamId       String?
  seedOverallRating   Int?
  seedPotentialRating Int?
  pathway             ProspectPathway?
  draftProspectId     String?                  @unique
  leaguePlayers       LeaguePlayer[]
  seasonStats         PlayerSeasonStat[]
  seedContractYears   PlayerSeedContractYear[]
  currentTeam         Team?                    @relation(fields: [currentTeamId], references: [id])
  draftProspect       DraftProspect?           @relation(fields: [draftProspectId], references: [id], onDelete: SetNull)

  @@index([currentTeamId])
  @@map("players")
}

/// A year of a player's real, imported contract, used to seed a new league so
/// year one matches the real NBA instead of the valuation model's opinion.
/// Absent for players the contract source did not cover - those get a
/// generated deal. See src/lib/league/planLeaguePlayer.ts.
model PlayerSeedContractYear {
  id          String @id @default(cuid())
  playerId    String
  season      Int
  salaryCents BigInt
  player      Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
  @@map("player_seed_contract_years")
}

model PlayerSeasonStat {
  id                   String @id @default(cuid())
  playerId             String
  season               Int
  team                 String
  gamesPlayed          Int
  minutesPerGame       Float
  pointsPerGame        Float
  reboundsPerGame      Float
  assistsPerGame       Float
  stealsPerGame        Float
  blocksPerGame        Float
  turnoversPerGame     Float
  fgPct                Float?
  fg3Pct               Float?
  ftPct                Float?
  trueShootingPct      Float?
  usagePct             Float?
  winSharesPer48       Float?
  boxPlusMinus         Float?
  valueOverReplacement Float?
  player               Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, team])
  @@index([playerId])
  @@map("player_season_stats")
}

model League {
  id                          String                    @id @default(cuid())
  name                        String
  ownerId                     String
  userControlledTeamId        String?
  currentSeason               Int
  seasonStartedAt             DateTime                  @default(now())
  /// When the user last opened this save, and where the news feed had been
  /// read up to at that moment. Distinct from `updatedAt`, which moves on
  /// every write (including CPU activity during a simulation) and so can
  /// never answer "what happened while I was gone" - by the time the user
  /// returns, `updatedAt` reflects the simulation, not the visit.
  ///
  /// `lastSeenAt` is the visit clock: read on arrival to compute the diff,
  /// then advanced. `newsReadThroughAt` is the read boundary, advanced only
  /// when the user actually views the feed, so unread counts survive a
  /// dashboard glance that never opened the news.
  ///
  /// Null on a save that has never been opened since this field existed;
  /// the returning-player surface degrades to "welcome back" rather than
  /// inventing a window it cannot know.
  lastSeenAt                  DateTime?
  newsReadThroughAt           DateTime?
  salaryCapOverrideCents      BigInt?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  ownerConfidence             Int                       @default(65)
  payrollDirectiveSeason      Int?
  payrollReductionTargetCents BigInt?
  endReason                   CareerEndReason?
  endedAt                     DateTime?
  financialMandateSeason      Int?
  financialMandateStaked      Boolean                   @default(false)
  payrollDirectiveStaked      Boolean                   @default(false)
  tourCompletedAt             DateTime?
  allStarWeekends             AllStarWeekend[]
  assistantThreads            AssistantThread[]
  businessDecisions           BusinessDecision[]
  businessLedgerEntries       BusinessLedgerEntry[]
  capitalProjects             CapitalProject[]
  careerRecords               CareerRecord[]
  draftPicks                  DraftPick[]
  draftProspectBookmarks      DraftProspectBookmark[]
  draftProspects              DraftProspect[]
  fanCultures                 FanCulture[]
  fanHappinessSnapshots       FanHappinessSnapshot[]
  fanMandates                 FanMandate[]
  fanNarratives               FanNarrative[]
  fanSentimentEvents          FanSentimentEvent[]
  financialSnapshots          FinancialSnapshot[]
  games                       Game[]
  players                     LeaguePlayer[]
  teams                       LeagueTeam[]
  transactions                LeagueTransaction[]
  owner                       User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lotteryResults              LotteryResult[]
  negotiations                Negotiation[]
  playerGameStats             PlayerGameStat[]
  playerSeasonRollups         LeaguePlayerSeasonStat[]
  playoffSeries               PlayoffSeries[]
  scoutingAssignmentSpends    ScoutingAssignmentSpend[]
  seasonAwards                SeasonAward[]
  seasonExpectations          SeasonExpectation[]
  sponsorshipDeals            SponsorshipDeal[]
  staff                       Staff[]
  staffAwards                 StaffAward[]
  tradeExceptions             TradeException[]
  trades                      Trade[]

  @@index([ownerId])
  @@map("leagues")
}

model SeasonExpectation {
  id                   String             @id @default(cuid())
  leagueId             String
  season               Int
  expectationLevel     ExpectationLevel
  actualResultLabel    String?
  verdict              EvaluationVerdict?
  ownerConfidenceDelta Int?
  createdAt            DateTime           @default(now())
  league               League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season])
  @@map("season_expectations")
}

model LeagueTransaction {
  id                    String          @id @default(cuid())
  leagueId              String
  season                Int
  type                  TransactionType
  description           String
  createdAt             DateTime        @default(now())
  importance            NewsImportance  @default(STANDARD)
  /// The day of the season this story belongs to, matching Game.dayIndex.
  /// Null for anything with no game day - offseason moves, the draft, finance
  /// reports - and for every row written before this column existed.
  ///
  /// Needed because `createdAt` cannot order or group stories: simulation
  /// writes hundreds of rows in a single createMany, so they all share one
  /// timestamp to the millisecond. Without this the news feed can only group
  /// by season, which is why it read as one undifferentiated log.
  dayIndex              Int?
  teamIds               String[]        @default([])
  subjectLeaguePlayerId String?
  /// The executed trade that generated this row, when one did. Null for the
  /// overwhelming majority of transactions (signings, injuries, awards,
  /// retirements). SetNull rather than Cascade because deleting a trade must
  /// never destroy league news - same reasoning as Player.draftProspectId.
  tradeId               String?
  league                League          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  trade                 Trade?          @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@index([leagueId, createdAt])
  @@index([leagueId, season, dayIndex])
  @@index([subjectLeaguePlayerId])
  @@index([tradeId])
  @@map("league_transactions")
}

model LeagueTeam {
  id                           String                 @id @default(cuid())
  leagueId                     String
  teamId                       String
  wins                         Int                    @default(0)
  losses                       Int                    @default(0)
  gmPersonality                GmPersonality          @default(BALANCED)
  currentStreak                Int                    @default(0)
  fanHappiness                 Int                    @default(65)
  totalPayrollPaidCents        BigInt                 @default(0)
  cashReserveCents             BigInt                 @default(0)
  franchiseValueCents          BigInt                 @default(0)
  ticketPricingPosture         TicketPricingPosture   @default(STANDARD)
  analyticsLevel               DepartmentLevel        @default(STANDARD)
  coachingSupportLevel         DepartmentLevel        @default(STANDARD)
  marketingLevel               DepartmentLevel        @default(STANDARD)
  playerDevelopmentLevel       DepartmentLevel        @default(STANDARD)
  scoutingLevel                DepartmentLevel        @default(STANDARD)
  seasonTicketBase             Int                    @default(65)
  sportsScienceLevel           DepartmentLevel        @default(STANDARD)
  arenaAgeSeasons              Int                    @default(0)
  arenaLeaseExpiresSeason      Int                    @default(0)
  arenaQualityIndex            Int                    @default(65)
  debtCents                    BigInt                 @default(0)
  failedArenaNegotiations      Int                    @default(0)
  marketSizeOverride           MarketSize?
  relocatedAtSeason            Int?
  relocatedCityName            String?
  ownerArchetype               OwnerArchetype         @default(PATIENT_BUILDER)
  ownerArchetypeSince          Int                    @default(0)
  businessDecisions            BusinessDecision[]
  deadMoney                    DeadMoney[]
  businessLedgerEntries        BusinessLedgerEntry[]
  capitalProjects              CapitalProject[]
  contracts                    Contract[]
  ownedPicks                   DraftPick[]            @relation("CurrentOwner")
  originalPicks                DraftPick[]            @relation("OriginalTeam")
  fanCulture                   FanCulture?
  fanHappinessSnapshots        FanHappinessSnapshot[]
  fanMandate                   FanMandate?
  fanNarratives                FanNarrative[]
  fanSentimentEvents           FanSentimentEvent[]
  financialSnapshots           FinancialSnapshot[]
  awayGames                    Game[]                 @relation("AwayGames")
  homeGames                    Game[]                 @relation("HomeGames")
  players                      LeaguePlayer[]
  reSigningRightsHolders       LeaguePlayer[]         @relation("ReSigningRights")
  league                       League                 @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team                         Team                   @relation(fields: [teamId], references: [id])
  lotteryResultsAsCurrentOwner LotteryResult[]        @relation("LotteryResultCurrentOwnerTeam")
  lotteryResultsAsOriginalTeam LotteryResult[]        @relation("LotteryResultOriginalTeam")
  negotiations                 Negotiation[]
  playerGameStats              PlayerGameStat[]
  higherSeedIn                 PlayoffSeries[]        @relation("HigherSeedSeries")
  lowerSeedIn                  PlayoffSeries[]        @relation("LowerSeedSeries")
  wonSeries                    PlayoffSeries[]        @relation("WonSeries")
  sponsorshipDeals             SponsorshipDeal[]
  staff                        Staff[]
  staffContracts               StaffContract[]
  tradeAssetsFrom              TradeAsset[]           @relation("AssetFromTeam")
  tradeAssetsTo                TradeAsset[]           @relation("AssetToTeam")
  tradeExceptions              TradeException[]

  @@unique([leagueId, teamId])
  @@index([leagueId])
  @@map("league_teams")
}

model FanHappinessSnapshot {
  id                  String     @id @default(cuid())
  leagueId            String
  leagueTeamId        String
  season              Int
  fanHappiness        Int
  attendancePct       Float
  franchisePopularity Int
  league              League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueTeam          LeagueTeam @relation(fields: [leagueTeamId], references: [id], onDelete: Cascade)

  @@unique([leagueId, leagueTeamId, season])
  @@index([leagueId, leagueTeamId])
  @@map("fan_happiness_snapshots")
}

model Game {
  id               String           @id @default(cuid())
  leagueId         String
  season           Int
  gameNumber       Int
  homeLeagueTeamId String
  awayLeagueTeamId String
  homeScore        Int?
  awayScore        Int?
  playedAt         DateTime?
  seriesId         String?
  type             GameType         @default(REGULAR_SEASON)
  dayIndex         Int?
  awayTeam         LeagueTeam       @relation("AwayGames", fields: [awayLeagueTeamId], references: [id])
  homeTeam         LeagueTeam       @relation("HomeGames", fields: [homeLeagueTeamId], references: [id])
  league           League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  series           PlayoffSeries?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  playerGameStats  PlayerGameStat[]

  @@index([leagueId, season])
  @@index([leagueId, playedAt])
  @@map("games")
}

model PlayerGameStat {
  id             String       @id @default(cuid())
  gameId         String
  leaguePlayerId String
  leagueTeamId   String
  season         Int
  gameType       GameType
  minutesPlayed  Int
  points         Int
  rebounds       Int
  assists        Int
  steals         Int
  blocks         Int
  turnovers      Int
  fgMade         Int
  fgAttempted    Int
  fg3Made        Int
  fg3Attempted   Int
  ftMade         Int
  ftAttempted    Int
  leagueId       String
  game           Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  league         League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leaguePlayer   LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)
  leagueTeam     LeagueTeam   @relation(fields: [leagueTeamId], references: [id])

  @@unique([gameId, leaguePlayerId])
  @@index([leaguePlayerId, season])
  @@index([leagueId, season])
  @@index([gameId])
  @@map("player_game_stats")
}

/**
 * One row per rate-limited action, holding only what a sliding window needs.
 * Postgres rather than Redis so the stack stays at two services. The cost is
 * one small indexed query per limited action; that is acceptable only because
 * the limited endpoints (signup, sign-in, league creation) are rare and
 * already make several database calls each. Do not extend this to hot paths
 * like simulation - see src/lib/rateLimit/policy.ts for why those are
 * deliberately unlimited.
 * `key` is "<policy>:<identifier>", where the identifier is an IP for
 * unauthenticated actions and a user id for authenticated ones. Rows are
 * swept opportunistically once past their window (src/lib/rateLimit/rateLimit.ts),
 * so this table stays small rather than becoming the growth problem it exists
 * to prevent.
 */
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

/**
 * One row per player per completed season, replacing that season's ~82
 * `PlayerGameStat` rows once the season is over.
 * Box scores are the dominant consumer of database size - a simulated season
 * writes roughly 24,000 of them, about 20 MB, and nothing in the simulation
 * ever reads a *past* season's. Every logic reader (All-Star selection,
 * offseason awards, in-season events, league leaders, the award race) scopes
 * its query to the season being played. The single cross-season read is career
 * highs, which are per-category maxima, so `high*` below preserves them
 * exactly rather than approximately.
 * Sums rather than averages so a rollup stays exactly re-derivable: any average
 * is sum/gamesPlayed, and summing across gameTypes stays correct. Team is
 * deliberately absent - a midseason trade would otherwise split a player's
 * season across rows, and nothing reads team from a past season.
 * See `src/lib/stats/rollupSeasonStats.ts` for the rollup, which is idempotent.
 */
model LeaguePlayerSeasonStat {
  id             String       @id @default(cuid())
  leagueId       String
  leaguePlayerId String
  season         Int
  gameType       GameType
  gamesPlayed    Int
  minutesPlayed  Int
  points         Int
  rebounds       Int
  assists        Int
  steals         Int
  blocks         Int
  turnovers      Int
  fgMade         Int
  fgAttempted    Int
  fg3Made        Int
  fg3Attempted   Int
  ftMade         Int
  ftAttempted    Int
  highPoints     Int
  highRebounds   Int
  highAssists    Int
  highSteals     Int
  highBlocks     Int
  league         League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leaguePlayer   LeaguePlayer @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([leaguePlayerId, season, gameType])
  @@index([leagueId, season])
  @@map("league_player_season_stats")
}

model PlayoffSeries {
  id               String      @id @default(cuid())
  leagueId         String
  season           Int
  round            Int
  conference       Conference?
  higherSeedTeamId String
  lowerSeedTeamId  String
  winsNeeded       Int         @default(4)
  higherSeedWins   Int         @default(0)
  lowerSeedWins    Int         @default(0)
  winnerTeamId     String?
  bracketSlot      Int         @default(0)
  games            Game[]
  higherSeedTeam   LeagueTeam  @relation("HigherSeedSeries", fields: [higherSeedTeamId], references: [id])
  league           League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  lowerSeedTeam    LeagueTeam  @relation("LowerSeedSeries", fields: [lowerSeedTeamId], references: [id])
  winnerTeam       LeagueTeam? @relation("WonSeries", fields: [winnerTeamId], references: [id])

  @@index([leagueId, season, round])
  @@map("playoff_series")
}

model LeaguePlayer {
  id                         String                    @id @default(cuid())
  leagueId                   String
  playerId                   String
  leagueTeamId               String?
  overallRating              Int
  potentialRating            Int
  injuryStatus               InjuryStatus              @default(HEALTHY)
  isActive                   Boolean                   @default(true)
  retiredSeason              Int?
  injuryReturnsAtGamesPlayed Int?
  reSigningTeamId            String?
  careerGamesMissedToInjury  Int                       @default(0)
  rotationSlot               Int?
  targetMinutesPerGame       Int?
  morale                     Int                       @default(70)
  tradeRequestActive         Boolean                   @default(false)
  tradeRequestSince          Int?
  homegrown                  Boolean                   @default(false)
  joinedTeamSeason           Int?
  /// Day within `joinedTeamSeason` that this player joined his current team.
  /// Null for the seeded roster and for rows written before day tracking, both
  /// of which are treated as tradeable - see src/lib/trade/recentAcquisition.ts.
  joinedTeamDayIndex         Int?
  allStarEventParticipants   AllStarEventParticipant[]
  allStarGameStats           AllStarGameStat[]
  allStarSelections          AllStarSelection[]
  contract                   Contract?
  fanMandatesAsKeepOurGuy    FanMandate[]
  fanNarratives              FanNarrative[]
  fanSentimentEvents         FanSentimentEvent[]
  league                     League                    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueTeam                 LeagueTeam?               @relation(fields: [leagueTeamId], references: [id])
  player                     Player                    @relation(fields: [playerId], references: [id])
  reSigningTeam              LeagueTeam?               @relation("ReSigningRights", fields: [reSigningTeamId], references: [id])
  playerGameStats            PlayerGameStat[]
  playerSeasonRollups        LeaguePlayerSeasonStat[]
  personalityProfile         PlayerPersonalityProfile?
  seasonAwards               SeasonAward[]
  sponsorshipDealConditions  SponsorshipDeal[]
  tradeAssets                TradeAsset[]

  @@unique([leagueId, playerId])
  @@index([leagueId, leagueTeamId])
  @@map("league_players")
}

model SeasonAward {
  id             String        @id @default(cuid())
  leagueId       String
  season         Int
  category       AwardCategory
  leaguePlayerId String
  value          Float
  league         League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leaguePlayer   LeaguePlayer  @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season, category])
  @@index([leagueId, season])
  @@map("season_awards")
}

model Contract {
  id             String         @id @default(cuid())
  leaguePlayerId String         @unique
  leagueTeamId   String
  signedSeason   Int
  startSeason    Int
  endSeason      Int
  noTradeClause  Boolean        @default(false)
  signedUsing    ExceptionUsed  @default(NONE)
  years          ContractYear[]
  leaguePlayer   LeaguePlayer   @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)
  leagueTeam     LeagueTeam     @relation(fields: [leagueTeamId], references: [id])

  @@index([leagueTeamId])
  @@map("contracts")
}

model ContractYear {
  id              String             @id @default(cuid())
  contractId      String
  season          Int
  salaryCents     BigInt
  guaranteedCents BigInt
  optionType      ContractOptionType @default(NONE)
  contract        Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, season])
  @@map("contract_years")
}

model Staff {
  id           String         @id @default(cuid())
  leagueId     String
  leagueTeamId String?
  role         StaffRole
  fullName     String
  age          Int
  quality      Int
  reputation   Int            @default(50)
  style        CoachStyle?
  league       League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueTeam   LeagueTeam?    @relation(fields: [leagueTeamId], references: [id])
  staffAwards  StaffAward[]
  contract     StaffContract?

  @@index([leagueId, leagueTeamId])
  @@index([leagueId, role])
  @@map("staff")
}

model StaffContract {
  id                String     @id @default(cuid())
  staffId           String     @unique
  leagueTeamId      String
  signedSeason      Int
  startSeason       Int
  endSeason         Int
  annualSalaryCents BigInt
  leagueTeam        LeagueTeam @relation(fields: [leagueTeamId], references: [id])
  staff             Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_contracts")
}

model StaffAward {
  id       String             @id @default(cuid())
  leagueId String
  season   Int
  category StaffAwardCategory
  staffId  String
  value    Float
  league   League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  staff    Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season, category])
  @@index([leagueId, season])
  @@map("staff_awards")
}

model AllStarWeekend {
  id                  String                    @id @default(cuid())
  leagueId            String
  season              Int
  status              AllStarWeekendStatus      @default(PENDING)
  triggeredAtDayIndex Int?
  createdAt           DateTime                  @default(now())
  participants        AllStarEventParticipant[]
  game                AllStarGame?
  selections          AllStarSelection[]
  league              League                    @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, season])
  @@map("all_star_weekends")
}

model AllStarSelection {
  id               String               @id @default(cuid())
  allStarWeekendId String
  leaguePlayerId   String
  conference       Conference
  positionGroup    AllStarPositionGroup
  role             AllStarRole
  performanceScore Float
  pointsPerGame    Float
  reboundsPerGame  Float
  assistsPerGame   Float
  teamWinPct       Float
  allStarWeekend   AllStarWeekend       @relation(fields: [allStarWeekendId], references: [id], onDelete: Cascade)
  leaguePlayer     LeaguePlayer         @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([allStarWeekendId, leaguePlayerId])
  @@map("all_star_selections")
}

model AllStarEventParticipant {
  id               String           @id @default(cuid())
  allStarWeekendId String
  eventType        AllStarEventType
  leaguePlayerId   String
  seed             Int
  result           String
  score            Float
  allStarWeekend   AllStarWeekend   @relation(fields: [allStarWeekendId], references: [id], onDelete: Cascade)
  leaguePlayer     LeaguePlayer     @relation(fields: [leaguePlayerId], references: [id], onDelete: Cascade)

  @@unique([allStarWeekendId, eventType, leaguePlayerId])
  @@map("all_star_event_participants")
}

model AllStarGame {
  id                String            @id @default(cuid())
  allStarWeekendId  String            @unique
  teamACaptainId    String
  teamBCaptainId    String
  teamAScore        Int
  teamBScore        Int
  mvpLeaguePlayerId String
  stats             AllStarGameStat[]
  allStarWeekend    AllStarWeekend    @relation(fields: [allStarWeekendId], references: [id], onDelete: Cascade)

  @@map("all_star_games")
}

model AllStarGameStat {
  id             String       @id @default(cuid())
  allStarGameId  String
  leaguePlayerId String
  side           String
  minutesPlayed  Int
  points         Int
  rebounds       Int
  assists        Int
  steals         Int
  blocks         Int
  turnovers      Int
  fgMade         Int
  fgAttempted    Int
  fg3Made        Int
