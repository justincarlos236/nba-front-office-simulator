/// Guaranteed money still owed to a player who is no longer on the roster.
/// One row per season a release keeps charging for, so the cap sheet can read
/// a club's dead money for any single season without unpacking contracts that
/// no longer exist.
model DeadMoney {
  id           String     @id @default(cuid())
  leagueId     String
  leagueTeamId String
  season       Int
  amountCents  BigInt
  /// Kept for the cap sheet's own explanation - a dead-money line that cannot
  /// name who it is for is unreadable to the person paying it.
  playerName   String
  waivedSeason Int
  leagueTeam   LeagueTeam @relation(fields: [leagueTeamId], references: [id], onDelete: Cascade)

  @@index([leagueTeamId, season])
  @@index([leagueId, season])
  @@map("dead_money")
}
