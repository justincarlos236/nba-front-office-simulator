# Postgres connection string (Neon, local, or any Postgres-compatible provider)
DATABASE_URL="postgresql://user:password@localhost:5432/nba_front_office?sslmode=require&uselibpqcompat=true"

# Auth.js - generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="generate-a-random-value"

# Anthropic API key for the AI GM assistant (not yet used)
ANTHROPIC_API_KEY=""

# Only needed to regenerate prisma/data/players.json from scratch via
# `npm run import:players` - not required to run the app or seed the
# database, since that fixture is already bundled in the repo.
BALLDONTLIE_API_KEY=""
